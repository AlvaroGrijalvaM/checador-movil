# Puerto del servidor API
PORT=4000

# Conexion MySQL (base creada con checador_db/Script Completo.txt)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checador_db

# Secreto para firmar los JWT (cambiar en produccion)
JWT_SECRET=checador_dev_secret_cambiar
JWT_EXPIRES_IN=12h

# URL publica usada para construir las URLs de las fotos subidas
PUBLIC_BASE_URL=http://localhost:4000

# Carpeta donde se guardan las fotografias de las checadas
UPLOAD_DIR=uploads